# Candidate Screening Agent - Environment Configuration Example
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file or share its contents.

# App Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Instahyre Configuration
# Automated login credentials (read only by backend, never sent to UI/logs)
INSTAHYRE_EMAIL=
INSTAHYRE_PASSWORD=

# Default search URL with all preserved boolean filters and parameters
INSTAHYRE_SEARCH_URL=https://www.instahyre.com/employer/search/results/?boolean_query=%28+GO+OR+Golang+AND+Routines+AND+%28+LLD+OR+HLD+OR+%22System+Design%22+OR+%22Distributed+Systems%22+OR+SOLID+%29+AND+%28+Leetcode+OR+codechef+OR+hackerrank+OR+Scaler+OR+Crio+OR+%22Coding+ninjas%22+OR+ICPC+OR+codeforces+OR+Geeksforgeeks+%29+%29&company_size=50%2C200%2C500%2C1000&entire_resume=true&gender=1&hide_viewed_by_others=false&hide_viewed_by_self=false&job_functions=1%3A10&large_company_size=true&limit_count=true&management_role=1&mid_company_size=true&must_match_education=false&notice_period=0&pg_education=0&salary_max=10&salary_min=4&search_skill_option=1&selected_search_option=3&small_company_size=false&status=1&ug_education=0&workex_max=3&workex_min=1

# GitHub Configuration (Official REST API Token)
GITHUB_TOKEN=

# Database
DATABASE_URL=sqlite:///./data/screening_agent.db

# Operational Controls
DRY_RUN=true
HEADLESS_BROWSER=false
MAX_CANDIDATES_PER_RUN=50
API_REQUEST_TIMEOUT_SECONDS=15
